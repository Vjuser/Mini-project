pipeline {
    agent any

    stages {

        stage('Verify Ansible') {
            steps {
                sh 'ansible --version'
            }
        }

        stage('Check Connectivity') {
            steps {
                sh 'ansible all -i inventory.txt -m ping'
            }
        }

        stage('Deploy NGINX') {
            steps {
                sh 'ansible-playbook -i inventory.txt playbook.yaml'
            }
        }

    }
}

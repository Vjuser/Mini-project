pipeline {
    agent any

    stages {

        stage('Verify Ansible') {
            steps {
                sh 'ansible --version'
            }
        }

        stage('Check Connectivity') {
            steps {
                sh 'ansible web -i inventory.txt -m ping -u ubuntu'
            }
        }

        stage('Deploy NGINX') {
            steps {
                sh 'ansible-playbook -i inventory.ini playbook.yaml'
            }
        }

    }
}
